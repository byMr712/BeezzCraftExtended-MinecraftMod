{
  "schemaVersion": 1,
  "id": "beezzcraft",
  "version": "${version}",
  "name": "BeezzCraft (Extended)",
  "description": "Ctrl + right click on an item: an octagon wheel of everything you can craft from it. Grey means missing resources; hover for the recipe, click to craft.",
  "icon": "assets/beezzcraft/icon.png",
  "authors": [
    "BeezzLand & Mr712"
  ],
  "contact": {
    "homepage": "https://github.com/byMr712/BeezzCraftExtended-MinecraftMod",
    "sources": "https://github.com/byMr712/BeezzCraftExtended-MinecraftMod",
    "issues": "https://github.com/byMr712/BeezzCraftExtended-MinecraftMod/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "land.beezz.craft.BeezzCraftClient"
    ],
    "modmenu": [
      "land.beezz.craft.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "beezzcraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
